{
  "name": "piano-sheet-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest:mutopia": "node scripts/ingest-mutopia.mjs",
    "fingerprint:catalog": "vite build --config scripts/vite.ssr.config.ts --ssr scripts/fingerprint-catalog.ts && node .cache/ssr/fingerprint-catalog.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.0",
    "three": "^0.185.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
